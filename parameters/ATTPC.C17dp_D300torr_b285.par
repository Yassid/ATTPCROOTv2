##############################################################################
# 17C(d,p)18C -- SOLARIS + AT-TPC proposal simulation (C17p_FRIB_Proposal)
# D2 at 300 torr / 293 K, B = 2.85 T, drift 1000 mm, real AT-TPC pad plane.
#
# Generated by macro/Simulation/ATTPC/17C_dp/make_c17dp_par.sh on 2026-09-01.
# Source: parameters/ATTPC.a1954_C14dp_b285.par, UNCHANGED. The 14C(d,p) reference
# campaign and this one differ by the beam and the reaction only -- both of which are set
# in the sim macro, not here -- so any difference in the result is the reaction.
#
# Beam for this channel (in C17_dp_sim.C, not in this file): 17C at 8.37 MeV/u =
# 142.29 MeV, ReA6, 940 pps. Q(d,p) = +1.959 MeV. 18C has four bound states:
# 0 (0+), 1.588 (2+), 2.515 ((2+)), 3.972 ((2,3)+), with S_n = 4.184 MeV.
#
# Gas: Density 0.065643 mg/cm3 is set EQUAL to the transport geometry ATTPC_D300torr_v2
# (6.5643e-5 g/cm3), so digitisation and transport model the same gas.
# DriftVelocity 1.10424 cm/us, measured on a1975 D2 data at this field.
# CoefT 9e-4 cm2/us is the legacy value the Magboltz D2 scan is anchored on at 2.85 T.
##############################################################################
[AtDigiPar]
PadPlaneX:Int_t                864   # mm
PadPlaneZ:Int_t               1344   # mm
PadSizeX:Int_t                   8   # mm
PadSizeZ:Int_t                  12   # mm
PadRows:Int_t                  108   #
PadLayers:Int_t                112   #
AnodeWirePlaneY:Double_t     -4.05   # mm
GroundWirePlaneY:Double_t     -8.1   # mm
GatingWirePlaneY:Double_t      -14   # mm
EField:Double_t               5000   # V/m
NumTbs:Int_t                   512
SamplingRate:Int_t             6.0   #
DriftVelocity:Double_t 1.10424 # cm/us. D2, measured on a1975 data
DriftLength:Double_t          1000   # mm //ATTPC : 1000 - Prototype : 500
YDivider:Int_t                1000   # Full drift length will be divided by this number when finding cluster
GasFile:Int_t                    2
PadPlaneFile:Int_t               3
PadShapeFile:Int_t               4   # might not be needed because the shape is simply rectangle
BField:Double_t           2.85   # Tesla
TiltAng:Double_t               0.0   # Degrees
TB0:Int_t                       98   # Time Bucket reference for micromegas position (DEPRECATED)
LorentzAngle:Double_t          0.0   # Lorentz Angle
TBEntrance:Int_t               480   # Beam position at detector entrance in TB
ZPadPlane:Double_t          1000.0   # Position of the micromegas pad plane
Density:Double_t      0.065643   # mg/cm3. D2 300 torr, = the transport geometry
ThetaPad:Double_t            110.9   # AT-TPC pad plane rotation
ThetaRot:Double_t              0.0   # Second Lorentz Angle
GasPressure:Double_t           300   # Gas pressure in torr
EIonize:Double_t            15.603   # Ionization energy of gas in eV
Fano:Double_t                 0.24   # Fano factor of the gas
CoefL:Double_t              0.0009   # Longitudal coefficient of diffusion [cm^2/us]
CoefT:Double_t          0.0009   # Transverse diffusion [cm^2/us], see header
Gain:Double_t           150000   # as the pp campaign; 35000 starves 2 mm pads
GETGain:Double_t              1000   # Gain of the GET electronics in fC
PeakingTime:Int_t              720   # Electronic peaking time in ns
MaxRange:Double_t            500.0   # Maximum range from Beam energy in mm
