##############################################################################
# 10Be(t,p)12Be FIELD x PAD-PITCH STUDY -- T2 at 300 torr, B = 7.0 T
#
# Generated by macro/Simulation/ATTPC/10Be_tp/make_tp_pars.sh on 2026-08-31.
# Base: parameters/ATTPC.a1954_C14dp_b285.par, so everything not gas-related is
# identical to the 14C(d,p) campaign and the two channels differ by the reaction
# and the target gas alone.
#
# Gas: T2 at 300 torr, 293.15 K. Density 0.0989854 mg/cm3, set EQUAL to the transport
# geometry ATTPC_T300torr, so digitisation and transport model the same gas. Same
# molecular number density -- hence the same ELECTRON density -- as the H2 and D2
# fills of the sibling campaigns.
# DriftVelocity 1.10424 cm/us is the D2 value, HELD: no T2 measurement exists and
# Magboltz has no tritium. It is self-consistent (digi and reco read this same par) so
# it sets only the z scale. Isotope extrapolation from the H2->D2 step suggests ~-5 %.
# Gain 150000, as the (d,p) campaign; 35000 starves a 2 mm pad plane.
#
# Transverse diffusion: anchored on the legacy 9e-4 at 2.85 T and scaled by
# (DT(B)/DT(2.85))^2 from the Magboltz D2 scan (300 torr, 293 K, 50 V/cm, B || E).
# The RATIO is what is isotope-robust: DT(7)/DT(2.85) = 0.4396 in H2 vs 0.4501 in D2,
# a 2.4 % spread over a factor-two mass change, while the absolute DT moves 18-21 %.
#     DT = 525.929 / 197.218 / 148.23 / 88.7761 um/sqrt(cm) at 0 / 2.85 / 4 / 7 T (D2)
#     DL = 390.41 um/sqrt(cm), field-independent, as it must be for B || E
##############################################################################
[AtDigiPar]
PadPlaneX:Int_t                864   # mm
PadPlaneZ:Int_t               1344   # mm
PadSizeX:Int_t                   8   # mm
PadSizeZ:Int_t                  12   # mm
PadRows:Int_t                  108   #
PadLayers:Int_t                112   #
AnodeWirePlaneY:Double_t     -4.05   # mm
GroundWirePlaneY:Double_t     -8.1   # mm
GatingWirePlaneY:Double_t      -14   # mm
EField:Double_t               5000   # V/m
NumTbs:Int_t                   512
SamplingRate:Int_t             6.0   #
DriftVelocity:Double_t 1.10424 # cm/us. HELD at the D2 value, see header
DriftLength:Double_t          1000   # mm //ATTPC : 1000 - Prototype : 500
YDivider:Int_t                1000   # Full drift length will be divided by this number when finding cluster
GasFile:Int_t                    2
PadPlaneFile:Int_t               3
PadShapeFile:Int_t               4   # might not be needed because the shape is simply rectangle
BField:Double_t            7.0   # Tesla
TiltAng:Double_t               0.0   # Degrees
TB0:Int_t                       98   # Time Bucket reference for micromegas position (DEPRECATED)
LorentzAngle:Double_t          0.0   # Lorentz Angle
TBEntrance:Int_t               480   # Beam position at detector entrance in TB
ZPadPlane:Double_t          1000.0   # Position of the micromegas pad plane
Density:Double_t     0.0989854  # mg/cm3. T2 300 torr, = the transport geometry
ThetaPad:Double_t            110.9   # AT-TPC pad plane rotation
ThetaRot:Double_t              0.0   # Second Lorentz Angle
GasPressure:Double_t           300   # Gas pressure in torr
EIonize:Double_t            15.603   # Ionization energy of gas in eV
Fano:Double_t                 0.24   # Fano factor of the gas
CoefL:Double_t              0.0009   # Longitudal coefficient of diffusion [cm^2/us]
CoefT:Double_t        0.000182   # Transverse diffusion [cm^2/us], see header
Gain:Double_t           150000   # as the pp campaign; 35000 starves 2 mm pads
GETGain:Double_t              1000   # Gain of the GET electronics in fC
PeakingTime:Int_t              720   # Electronic peaking time in ns
MaxRange:Double_t            500.0   # Maximum range from Beam energy in mm
