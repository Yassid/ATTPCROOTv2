################################################################################
# a1975 16C(p,d)15C SIMULATION parameters.
#
# Derived from ATTPC.a1954_C14_sim.par. The gas is H2 at 300 torr, the same as a1954.
#
# !! THE PRODUCTION RECONSTRUCTION DISAGREES WITH THIS !!
# The a1975 data reconstruction uses geometry ATTPC_H1bar (8.27e-5 g/cm3) and a fitter
# gasDensity of 9.0e-5, against the correct 3.308e-5 -- 2.5 times too much material. Energy loss
# scales with path length, so the resulting error is angle- and vertex-dependent.
#
# !! GAIN AND DIFFUSION ARE NOT TUNED FOR a1975 !!
# Gain 150000 and CoefT/L 0.0009 are carried over from a1954, where they were established by
# matching simulated track width and charge to that data set. They have NOT been checked against
# a1975. For a1954 the original value was ~15x too low, so this is not a small effect: it changes
# how many marginal tracks survive and therefore the acceptance near threshold. Match track width
# and charge per unit length against a1975 data before treating any acceptance from this as final.
#
# ATTPC.a1954.par, which the a1975 reconstruction loads, declares 600 torr and 0.197 mg/cm3 --
# also not the real gas. Those entries drive digitisation rather than transport, but they are
# wrong too.
#
# Parameters used throughout ATTPCROOT software
# Format:
# parameter_name:parameter_type(Int_t-integer, Double_t-double) parameter_value
# AtDigiPar
# Description of parameters
################################################################################
[AtDigiPar]
PadPlaneX:Int_t                864   # mm
PadPlaneZ:Int_t               1344   # mm
PadSizeX:Int_t                   8   # mm
PadSizeZ:Int_t                  12   # mm
PadRows:Int_t                  108   #
PadLayers:Int_t                112   #
AnodeWirePlaneY:Double_t     -4.05   # mm
GroundWirePlaneY:Double_t     -8.1   # mm
GatingWirePlaneY:Double_t      -14   # mm
EField:Double_t               5000   # V/m
NumTbs:Int_t                   512
SamplingRate:Int_t             6.0   #
DriftVelocity:Double_t        1.30   # cm/us
DriftLength:Double_t          1000   # mm //ATTPC : 1000 - Prototype : 500
YDivider:Int_t                1000   # Full drift length will be divided by this number when finding cluster
GasFile:Int_t                    2
PadPlaneFile:Int_t               3
PadShapeFile:Int_t               4   # might not be needed because the shape is simply rectangle
BField:Double_t               2.85   # Tesla
TiltAng:Double_t               0.0   # Degrees
TB0:Int_t                       98   # Time Bucket reference for micromegas position (DEPRECATED)
LorentzAngle:Double_t          0.0   # Lorentz Angle
TBEntrance:Int_t               480   # Beam position at detector entrance in TB
ZPadPlane:Double_t          1000.0   # Position of the micromegas pad plane
Density:Double_t            0.0331   # mg/cm3. H2 at 300 torr, 293 K
ThetaPad:Double_t            110.9   # AT-TPC pad plane rotation
ThetaRot:Double_t              0.0   # Second Lorentz Angle
GasPressure:Double_t           300   # Gas pressure in torr
EIonize:Double_t            15.603   # Ionization energy of gas in eV
Fano:Double_t                 0.24   # Fano factor of the gas
CoefL:Double_t              0.0009   # Longitudal coefficient of diffusion [cm^2/us]
CoefT:Double_t              0.0009   # Transverse coefficient of diffusion [cm^2/us]
Gain:Double_t      5000000   # gain scan variant
GETGain:Double_t              1000   # Gain of the GET electronics in fC
PeakingTime:Int_t              720   # Electronic peaking time in ns
MaxRange:Double_t            500.0   # Maximum range from Beam energy in mm
################################################################################
