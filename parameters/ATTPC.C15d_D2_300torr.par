################################################################################
# 15C + d  --  D2 active target at 300 torr, room temperature
#
# NEW FILE for the C15d workspace (macro/Unpack_HDF5/C15d/). Nothing else reads it.
#
# * THE DRIFT WORKING POINT IS MEASURED, NOT INHERITED. An earlier version of this file took it
# from Spyral's window_time_bucket = 300 and micromegas_time_bucket = 25 and was WRONG BY 0.575.
# Measured instead with drift_check_C15d.C over six runs:
#
#     pad plane   time bucket  20.2   (sharp lower edge of the hit-time distribution)
#     window      time bucket 498.5   (latest-arriving charge per track piles up and stops)
#     full drift        478.3 TB = 1000 mm  ->  2.091 mm per time bucket
#
# * SamplingRate MUST BE 6, NOT 3. AtDigiPar::GetTBTime() maps 6 -> 160 ns (6.25 MHz) and 3 -> 320.
# Spyral's config says get_frequency = 3.125, and the a2091 par literally reads
#     SamplingRate:Int_t 3.125 # a2091 (real value 6.25 MHz)
# which AtDigiPar truncates to 3 and so reconstructs at 320 ns. Taking 3.125 at face value is how
# this file got 320 ns and a drift velocity a factor two off.
#
# The measurement fixes the PRODUCT dv * TBTime. The split comes from the sampling frequency:
# at 160 ns, dv = 1.307 cm/us -- and a2091 uses 1.30 for the SAME detector at the same 300 torr and
# 45 kV/m, with H2 and D2 having near-identical electron transport. At 320 ns it would have to be
# 0.653, half the sibling value with nothing to justify it.
#
# CONSISTENCY: (498 - 20) TB * 160 ns * 1.307 cm/us = 999.5 mm = the drift length. Changing any of
# SamplingRate, DriftVelocity, TBEntrance or ZPadPlane without re-checking that product moves the
# pad plane off z = 0 and rescales every angle, energy and excitation energy COHERENTLY -- which is
# exactly why the previous error survived every kinematic cross-check.
#
# Density matches geometry/media.geo entry TargetD2_300 (6.5643e-5 g/cm3) EXACTLY, so
# the UKF's CATIMA model and genfit's TGeo material describe the same gas. Do not edit
# one without the other.
################################################################################
[AtDigiPar]
PadPlaneX:Int_t                864   # mm
PadPlaneZ:Int_t               1344   # mm
PadSizeX:Int_t                   8   # mm
PadSizeZ:Int_t                  12   # mm
PadRows:Int_t                  108   #
PadLayers:Int_t                112   #
AnodeWirePlaneY:Double_t     -4.05   # mm
GroundWirePlaneY:Double_t     -8.1   # mm
GatingWirePlaneY:Double_t      -14   # mm
EField:Double_t              45000   # V/m   (Spyral electric_field)
NumTbs:Int_t                   512
SamplingRate:Int_t               6   # -> 160 ns/TB = 6.25 MHz. NOT 3: see the header.
DriftVelocity:Double_t       1.307   # cm/us  MEASURED (drift_check_C15d.C), not derived
DriftLength:Double_t        1000.0   # mm
YDivider:Int_t                1000   # Full drift length divided by this when finding clusters
GasFile:Int_t                    2
PadPlaneFile:Int_t               3
PadShapeFile:Int_t               4
BField:Double_t               2.85   # Tesla  (sign is a FITTER argument, not a par entry)
TiltAng:Double_t               0.0   # Degrees
TB0:Int_t                       20   # pad-plane TB, MEASURED; DEPRECATED and IGNORED anyway
LorentzAngle:Double_t          0.0   # Lorentz Angle
TBEntrance:Int_t               498   # MEASURED: latest-arriving charge piles up here
ZPadPlane:Double_t          1000.0   # mm  Spyral detector_length
Density:Double_t           0.065643  # mg/cm3 == 6.5643e-5 g/cm3. D2, 300 torr, ~295.2 K (22 C) --
ThetaPad:Double_t            110.9   # AT-TPC pad plane rotation
ThetaRot:Double_t              0.0   # Second Lorentz Angle
GasPressure:Double_t           300   # torr
EIonize:Double_t            15.603   # eV
Fano:Double_t                 0.24   #
CoefL:Double_t              0.0009   # Longitudinal diffusion [cm^2/us]
CoefT:Double_t              0.0009   # Transverse diffusion [cm^2/us]
Gain:Double_t                10000   # Micromegas gain
GETGain:Double_t              1000   # GET electronics gain [fC]
PeakingTime:Int_t              720   # ns
MaxRange:Double_t            500.0   # mm
