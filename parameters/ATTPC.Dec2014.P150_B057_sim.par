##############################################################################
# Dec 2014 alphas, 150 torr, B = 0.5691 T -- SIMULATION parameters.
#
# Derived from ATTPC.Dec2014.P300_B0_sim.par.  Only the gas density and the two
# fields differ.  The DRIFT VELOCITY IS DELIBERATELY UNCHANGED: this setting runs
# at 15 kV/m and 150 torr against 30 kV/m and 300 torr, so the reduced field E/p is
# identical and so is the drift velocity.  That is a real constraint, not an
# assumption -- the two settings were chosen that way.
##############################################################################
################################################################################
# Parameters used throughout ATTPCROOT software
# Format:
# parameter_name:parameter_type(Int_t-integer, Double_t-double) parameter_value
# AtDigiPar
# Description of parameters
################################################################################
# Dec 2014 alpha campaign, SIMULATION -- runs 38-113: 299.5 torr, 30 kV/m, B off.
# Beam is 11.40 MeV (2.85 MeV/u), NOT the 1.95 MeV/u in the Excel run log, which is wrong.
# v_D and tilt measured on run 100 (B=0); TBEntrance measured, was 280.
[AtDigiPar]
PadPlaneX:Int_t                864   # mm
PadPlaneZ:Int_t               1344   # mm
PadSizeX:Int_t                   8   # mm
PadSizeZ:Int_t                  12   # mm
PadRows:Int_t                  108   #
PadLayers:Int_t                112   #
AnodeWirePlaneY:Double_t     -4.05   # mm
GroundWirePlaneY:Double_t     -8.1   # mm
GatingWirePlaneY:Double_t      -14   # mm
EField:Double_t               15000   # V/m
NumTbs:Int_t                   512
SamplingRate:Int_t             6.0   # Real value is 6.25 MHz
DriftVelocity:Double_t        2.278   # cm/us
DriftLength:Double_t          1000   # mm //ATTPC : 1000 - Prototype : 500
YDivider:Int_t                1000   # Full drift length will be divided by this number when finding cluster
GasFile:Int_t                    2
PadPlaneFile:Int_t               3
PadShapeFile:Int_t               4   # might not be needed because the shape is simply rectangle
BField:Double_t             0.5691   # Tesla
TiltAng:Double_t              6.47   # Degrees
TB0:Int_t                       98   # Time Bucket reference for micromegas position (DEPRECATED)
LorentzAngle:Double_t          0.0   # Lorentz Angle
TBEntrance:Int_t               320   # Beam position at detector entrance in TB
ZPadPlane:Double_t          1000.0   # Position of the micromegas pad plane
Density:Double_t             0.0659   # Gas density (kg/m3 or mg/cm3)
ThetaPad:Double_t            110.9   # AT-TPC pad plane rotation
ThetaRot:Double_t              0.0   # Second Lorentz Angle
GasPressure:Double_t           299.5   # Gas pressure in torr
EIonize:Double_t            15.603   # Ionization energy of gas in eV
CoefL:Double_t               0.00002   # longitudinal diffusion [cm^2/us], simulation value
CoefT:Double_t               0.0002   # transverse diffusion [cm^2/us], simulation value
Gain:Double_t                 20000   # micromegas gain, as in the working ATTPC.e20020_sim.par
MaxRange:Double_t           1032.0   # Maximum range from Beam energy in mm
Fano:Double_t                 0.24   # Fano factor of the gas
GETGain:Double_t              1000   # Gain of the GET electronics in fC
PeakingTime:Int_t              720   # Electronic peaking time in ns
################################################################################
