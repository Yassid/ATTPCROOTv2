##############################################################################
# 14C(p,p') FIELD x PAD-PITCH CAMPAIGN -- B = 4.0 T
#
# Generated by macro/Simulation/ATTPC/14C_pp/highfield/make_hf_pars.sh on 2026-08-28.
# Base: parameters/ATTPC.a1954_C14_sim.par (the adopted a1954 simulation par).
# Changed: BField -> 4.0 T, CoefT -> 0.0009 cm2/us. CONTROL: diffusion deliberately frozen at the 2.85 T value.
#
# Transverse diffusion from Magboltz (H2, 300 torr, 293 K, 50 V/cm, B parallel to E),
# anchored on the a1954-tuned 9e-4 at 2.85 T and scaled by (DT(B)/DT(2.85))^2:
#     B = 0     DT = 489.841 um/sqrt(cm)
#     B = 2.85  DT = 167.113
#     B = 4.0   DT = 123.61
#     B = 7.0   DT = 73.4701
# Longitudinal diffusion is NOT touched: B parallel to E does not affect it
#     (DL = 405.917 / 376.852 / 387.175 / 396.926 um/sqrt(cm) at 0 / 2.85 / 4 / 7 T).
#
# TWO THINGS TO KNOW ABOUT THE SCAN. First, DriftVelocity is LEFT AT THE ADOPTED 1.30
# cm/us: Magboltz gives 0.436594 cm/us for pure H2 at 50 V/cm, three times less, and the
# 1.30 is a data-derived a1954 number that this study has no business overriding. The
# disagreement means the real gas is not the modelled one (mobility three times higher),
# so omega*tau is under- rather than over-estimated here. Second, that barely matters
# for the RATIO used above: once omega*tau >> 1, DT(B) goes as 1/B and the ratio tends
# to 2.85/B regardless of the mobility. At 7 T the two limits give CoefT 1.74e-4 (this
# scan) against 1.49e-4 (the 1/B limit) -- 7 % on sigma, which changes nothing.
#
# PadSizeX/Z, PadRows and PadLayers below are INERT -- AtDigiPar has no getters for
# them and the pad geometry comes entirely from the AtMap handed to AtPulseTask.
# Pass padSize_mm to run_reco_C14.C instead.
##############################################################################
[AtDigiPar]
PadPlaneX:Int_t                864   # mm
PadPlaneZ:Int_t               1344   # mm
PadSizeX:Int_t                   8   # mm
PadSizeZ:Int_t                  12   # mm
PadRows:Int_t                  108   #
PadLayers:Int_t                112   #
AnodeWirePlaneY:Double_t     -4.05   # mm
GroundWirePlaneY:Double_t     -8.1   # mm
GatingWirePlaneY:Double_t      -14   # mm
EField:Double_t               5000   # V/m
NumTbs:Int_t                   512
SamplingRate:Int_t             6.0   #
DriftVelocity:Double_t        1.30   # cm/us
DriftLength:Double_t          1000   # mm //ATTPC : 1000 - Prototype : 500
YDivider:Int_t                1000   # Full drift length will be divided by this number when finding cluster
GasFile:Int_t                    2
PadPlaneFile:Int_t               3
PadShapeFile:Int_t               4   # might not be needed because the shape is simply rectangle
BField:Double_t            4.0   # Tesla
TiltAng:Double_t               0.0   # Degrees
TB0:Int_t                       98   # Time Bucket reference for micromegas position (DEPRECATED)
LorentzAngle:Double_t          0.0   # Lorentz Angle
TBEntrance:Int_t               480   # Beam position at detector entrance in TB
ZPadPlane:Double_t          1000.0   # Position of the micromegas pad plane
Density:Double_t            0.0331   # mg/cm3. H2 at 300 torr, 293 K
ThetaPad:Double_t            110.9   # AT-TPC pad plane rotation
ThetaRot:Double_t              0.0   # Second Lorentz Angle
GasPressure:Double_t           300   # Gas pressure in torr
EIonize:Double_t            15.603   # Ionization energy of gas in eV
Fano:Double_t                 0.24   # Fano factor of the gas
CoefL:Double_t              0.0009   # Longitudal coefficient of diffusion [cm^2/us]
CoefT:Double_t          0.0009   # Transverse diffusion [cm^2/us], see header
Gain:Double_t               150000   # NOT 2.5e6: that matches charge/mm but flattens the width sqrt(z) growth. See project_a1954_c14_sim_match.
GETGain:Double_t              1000   # Gain of the GET electronics in fC
PeakingTime:Int_t              720   # Electronic peaking time in ns
MaxRange:Double_t            500.0   # Maximum range from Beam energy in mm
