15C(d,d')15C* 5/2+ 0.740 MeV at 191.25 MeV -- a2091;
NAMELIST
&FRESCO hcm=0.05 rmatch=60. rintp=1.00 hnl=0.100 rnl=10.00 centre=0.00
    jtmin=0.0 jtmax=200 absend=0.0010
    thmin=0.00 thmax=90.00 thinc=0.5
    chans=1 smats=1 xstabl=1 iblock=2
    elab(1)=191.250000 /

! 15C g.s. 1/2+ and the 5/2+ at 0.740, coupled by deformation of the deuteron optical
! potential (rotational model).  theta here is the DEUTERON CM angle; the analysis quotes
! theta_CM in the PROJECTILE convention, so compare at 180 - theta.
&PARTITION namep='d       ' massp=2.014102 zp=1 nex=2
           namet='C15     ' masst=15.010599 zt=6 qval=0.0000 /
&STATES jp=1.0 ptyp=1 ep=0.0000 cpot=1 jt=0.5 ptyt=1 et=0.0000 /
&STATES                         cpot=1 jt=2.5 ptyt=1 et=0.7400 /
&partition /

! Deuteron optical potential -- STARTING VALUES, to be searched against the measured
! elastic distribution before any inelastic result is believed.
! Each type=11 carries the deformation LENGTH (fm) of the type=1 above it.  0.90 fm is a
! placeholder: FIT IT to the measured 5/2+ distribution.
 &pot kp=1 ap=2.000 at=15.000 rc=1.30 /
 &pot kp=1 type=1  p(1:7)=  88.000  1.1700  0.7500  0.0000  0.0000  0.0000  0.0000 /
 &pot kp=1 type=11 p(1:3)=   0.900  1.1700  0.0000 /
 &pot kp=1 type=1  p(1:7)=   0.000  0.0000  0.0000 12.0000  1.3300  0.7900  0.0000 /
 &pot kp=1 type=11 p(1:3)=   0.900  1.3300  0.0000 /
 &pot kp=1 type=3  p(1:3)=   7.000  1.0700  0.6600 /
 &pot /
 &overlap /
 &coupling /
